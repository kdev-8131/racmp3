{
  "name": "racmp3",
  "productName": "RacMp3",
  "version": "1.0.0",
  "description": "RacMp3 - lecteur MP3",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV=1 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.racmp3.app",
    "productName": "RacMp3",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "RacMp3-${version}-installation.exe"
    },
    "portable": {
      "artifactName": "RacMp3-${version}-portable.exe"
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  }
}
